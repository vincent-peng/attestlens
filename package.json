{
  "name": "@attestlens/cli",
  "version": "0.4.0",
  "description": "Clearway by AttestLens: deterministic multi-jurisdiction privacy compliance runtime for AI agents.",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "cli": "./dist/cli/index.js",
    "attestlens": "./dist/cli/index.js",
    "attestlens-mcp": "./dist/mcp/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "scan": "tsx src/cli/index.ts scan",
    "audit": "tsx src/cli/index.ts audit",
    "report": "tsx src/cli/index.ts report",
    "validate:corpus": "tsx scripts/validate-corpus.ts",
    "validate:attest": "tsx scripts/prepare-attest-validation.ts",
    "test:watch": "vitest"
  },
  "keywords": [
    "compliance",
    "privacy-act",
    "privacy-compliance",
    "privacy",
    "australia",
    "ccpa",
    "cpra",
    "gdpr",
    "multi-jurisdiction",
    "ai-agents",
    "app",
    "ndb",
    "security",
    "scanner",
    "mcp"
  ],
  "author": "Vincent Peng",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vincent-peng/attestlens.git"
  },
  "bugs": {
    "url": "https://github.com/vincent-peng/attestlens/issues"
  },
  "homepage": "https://github.com/vincent-peng/attestlens#readme",
  "dependencies": {
    "@inquirer/prompts": "^8.4.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.4.0",
    "commander": "^13.1.0",
    "hono": "^4.12.14",
    "ora": "^8.2.0",
    "pdfkit": "^0.17.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
