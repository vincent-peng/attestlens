{
  "name": "attestlens",
  "version": "0.2.0",
  "description": "AI Compliance Scanner & Privacy Act Attestation Tool — Maps security findings to Australian Privacy Act (APP/NDB) obligations",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "attestlens": "./dist/cli/index.js",
    "attestlens-mcp": "./dist/mcp/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "scan": "tsx src/cli/index.ts scan",
    "audit": "tsx src/cli/index.ts audit",
    "report": "tsx src/cli/index.ts report",
    "validate:corpus": "tsx scripts/validate-corpus.ts",
    "test:watch": "vitest"
  },
  "keywords": [
    "compliance",
    "privacy",
    "australia",
    "app",
    "ndb",
    "security",
    "scanner",
    "mcp"
  ],
  "author": "Vincent Peng",
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chalk": "^5.4.0",
    "commander": "^13.1.0",
    "ora": "^8.2.0",
    "pdfkit": "^0.17.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
